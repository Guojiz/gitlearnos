{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlearnos.org/schemas/external-receipt/v1",
  "title": "GitLearnOS external provider receipt",
  "oneOf": [
    {
      "title": "RAG receipt",
      "type": "object",
      "required": ["schema", "kind", "provider", "source_id", "knowledge_ids", "doc_id", "git_source_record", "source_boundary", "ingest", "query", "rebuild", "delete", "observed_at"],
      "properties": {
        "schema": {"const": "gitlearnos.external-receipt/v1"},
        "kind": {"const": "rag"},
        "provider": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "knowledge_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "doc_id": {"type": "string", "minLength": 1},
        "git_source_record": {
          "type": "object",
          "required": ["path", "base_revision", "content_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "base_revision": {"type": "string", "minLength": 1},
            "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          },
          "additionalProperties": true
        },
        "source_boundary": {"type": "object", "required": ["evidence"], "properties": {"evidence": {"type": "string", "minLength": 1}}, "minProperties": 1},
        "ingest": {"$ref": "#/$defs/evidence"},
        "query": {"$ref": "#/$defs/evidence"},
        "rebuild": {"$ref": "#/$defs/evidence"},
        "delete": {"$ref": "#/$defs/evidence"},
        "observed_at": {"type": "string", "minLength": 1}
      },
      "$defs": {
        "evidence": {
          "type": "object",
          "required": ["status", "evidence"],
          "properties": {
            "status": {"enum": ["completed", "available", "unavailable", "failed"]},
            "evidence": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    {
      "title": "Scheduler receipt",
      "type": "object",
      "required": ["schema", "kind", "provider", "task_id", "tz", "recurrence", "run_id", "occurrence_key", "repo_revision", "result", "delivery_status", "message_id", "observed_at"],
      "properties": {
        "schema": {"const": "gitlearnos.external-receipt/v1"},
        "kind": {"const": "scheduler"},
        "provider": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "tz": {"type": "string", "minLength": 1},
        "recurrence": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "occurrence_key": {"type": "string", "minLength": 1},
        "repo_revision": {"type": "string", "minLength": 1},
        "result": {"enum": ["completed", "skipped", "failed", "unknown"]},
        "delivery_status": {"type": "string", "minLength": 1},
        "message_id": {"type": ["string", "null"]},
        "observed_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  ]
}
