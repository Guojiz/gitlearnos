{
  "name": "gitlearnos",
  "version": "2.0.0-alpha.1",
  "description": "Evidence-driven learning memory and automation for Git-native AI agents",
  "license": "MIT",
  "type": "module",
  "main": "./adapters/deepseek-harness/index.js",
  "exports": {
    ".": "./adapters/deepseek-harness/index.js",
    "./client": "./adapters/deepseek-harness/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "adapters/deepseek-harness",
    "skills/gitlearnos",
    "AGENTS.md",
    "GITLEARNOS.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check:dsh": "node scripts/check-dsh-bundle.mjs && node --check adapters/deepseek-harness/index.js",
    "test:dsh": "node --test adapters/deepseek-harness/test/bundle.test.js",
    "experiment:ordering": "node scripts/ordering-experiment.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./adapters/deepseek-harness/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "learning",
    "education",
    "rag",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guojiz/gitlearnos.git"
  }
}
